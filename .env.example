# Copia este archivo como .env (no se versiona). Todo es opcional.
ADMIN=admin              # usuario que ve el panel de administrador
DATA_PATH=/srv/data      # carpeta del servidor donde viven los datos
TZ=America/Bogota
SPOTDL_OFFICIAL=1        # 1: baja el audio oficial (canal verificado o «Topic») y solo si no existe, el video que mejor coincida; 0: siempre ese
SPOTDL_THREADS=4         # canciones que se descargan a la vez; bájalo si YouTube empieza a pedir verificación
MUSIC_MAX=8000           # tope de canciones de la biblioteca (0 = sin tope)
# GEMINI_PER_DAY=300     # solicitudes a Gemini al día entre todas las cuentas (necesita secrets/gemini.key en el servidor)
# COMPOSE_PROFILES=tunnel        # enciende Cloudflare Tunnel (necesita secrets/cloudflared.token en el servidor)
# DEPLOY_HOST=usuario@servidor   # solo para ./deploy.sh
